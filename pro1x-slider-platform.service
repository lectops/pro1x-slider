[Unit]
Description=Pro1 X exact-build Lomiri slider overlay
RequiresMountsFor=/userdata/system-data/pro1x-slider
Before=display-manager.service

[Service]
Type=oneshot
User=root
Group=root
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /userdata/system-data/pro1x-slider/install.py mount
ExecStop=/usr/bin/python3 /userdata/system-data/pro1x-slider/install.py unmount
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
