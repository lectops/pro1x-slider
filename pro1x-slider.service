[Unit]
Description=Pro1 X slider settings watcher
RequiresMountsFor=/userdata/system-data/pro1x-slider
# Both units are enabled independently. Ordering waits at boot without starting
# or retrying the privileged overlay when only this watcher is restarted.
After=systemd-udev-trigger.service pro1x-slider-platform.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=phablet
Group=phablet
SupplementaryGroups=android_input plugdev
Environment=PYTHONUNBUFFERED=1
Environment=SLIDER_STATE_DIR=/userdata/system-data/pro1x-slider/state
ExecStart=/usr/bin/python3 /userdata/system-data/pro1x-slider/slider.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
UMask=0077

[Install]
WantedBy=multi-user.target
